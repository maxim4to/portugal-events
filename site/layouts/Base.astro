---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  title: string;
  description?: string;
  /** Wide layout for the map explorer pages (drops the reading-width cap). */
  wide?: boolean;
  /** Phone bottom tab bar. Detail pages turn it off in favour of their own
      floating back/actions bar. */
  tabbar?: boolean;
}
const { title, description, wide, tabbar = true } = Astro.props;
const href = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="theme-color" content="#f2ece0" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    {/* Content runs under the status bar (the map/photos fill it); controls
        pad themselves by env(safe-area-inset-top). See .statusbar-scrim. */}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Португалия" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/apple-touch-icon.png')} />
    <link rel="icon" type="image/png" href={href('/icons/icon-192.png')} />
    <meta name="description" content={description ?? 'Места и события в Португалии'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Inter:wght@400..600&display=swap"
    />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var dark = window.matchMedia('(prefers-color-scheme: dark)');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') root.dataset.theme = t;
        } catch (e) {}
        // Keep the browser/status-bar tint on the page surface for the
        // resolved theme (explicit choice or system preference).
        function paint() {
          var isDark = root.dataset.theme ? root.dataset.theme === 'dark' : dark.matches;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', isDark ? '#17140f' : '#f2ece0');
        }
        // 'light' | 'dark' pin a theme; anything else follows the system.
        window.__setTheme = function (next) {
          try {
            if (next === 'dark' || next === 'light') {
              root.dataset.theme = next;
              localStorage.setItem('theme', next);
            } else {
              delete root.dataset.theme;
              localStorage.removeItem('theme');
            }
          } catch (e) {}
          paint();
        };
        paint();
        dark.addEventListener('change', paint);
      })();
    </script>
  </head>
  <body class:list={{ 'app-fill': wide, 'has-tabbar': tabbar }}>
    <IconSprite />
    <div class="statusbar-scrim" aria-hidden="true"></div>
    <Header />
    <main class:list={['main', { wide }]}>
      <slot />
    </main>
    {tabbar && <TabBar />}
    <script>
      import { trackPage } from '../lib/navStack.ts';
      trackPage();
      // Restored from the back/forward cache: scripts don't re-run, so note
      // which entry we're on again.
      addEventListener('pageshow', (e) => {
        if (e.persisted) trackPage();
      });
    </script>
  </body>
</html>

<style>
  .main {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-6);
  }

  /* Explorer pages: lock the app to the viewport so only the list scrolls —
     never the page itself. */
  :global(body.app-fill) {
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .main.wide {
    /* width:100% gives a definite cross-axis size so the flex column always
       stretches to the viewport. Without it, `margin:0 auto` disables stretch
       and the width becomes content-driven (differs per page). */
    width: 100%;
    max-width: 1400px;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  /* Phones: the explorer is a fixed full-screen app surface (map + sheet,
     see MapShell); nothing should rubber-band behind it. */
  @media (max-width: 760px) {
    :global(body.app-fill) {
      overscroll-behavior: none;
    }
    .main.wide {
      padding: 0;
    }
    .main:not(.wide) {
      padding-top: calc(env(safe-area-inset-top, 0px) + var(--space-4));
      padding-left: max(var(--space-4), env(safe-area-inset-left, 0px));
      padding-right: max(var(--space-4), env(safe-area-inset-right, 0px));
    }
  }
</style>
