---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  title: string;
  description?: string;
  /** Wide layout for the map explorer pages (drops the reading-width cap). */
  wide?: boolean;
  /** Detail pages: a wider reading container for content + sticky aside. */
  detail?: boolean;
  /** Phone bottom tab bar. Detail pages turn it off in favour of their own
      floating back/actions bar. */
  tabbar?: boolean;
}
const { title, description, wide, detail, tabbar = true } = Astro.props;
const href = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="theme-color" content="#f7f7f7" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    {/* Content runs under the status bar (the map/photos fill it); controls
        pad themselves by env(safe-area-inset-top). See .statusbar-scrim. */}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Португалия" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/apple-touch-icon.png')} />
    <link rel="icon" type="image/png" href={href('/icons/icon-192.png')} />
    <meta name="description" content={description ?? 'Места и события в Португалии'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..650&family=Inter:wght@400..700&display=swap"
    />
    <script is:inline>
      // Card photo ⇄ detail hero morph for cross-page view transitions (phones
      // and tablets; ≥1100px opens details in a panel instead). The old page
      // names its element in pageswap, the new one in pagereveal.
      (function () {
        var NAME = 'hero';
        var isList = function (p) { return /\/(places|events)\/$/.test(p); };
        var cover = function (path) {
          var a = document.querySelector('a[href="' + path + '"] .cover');
          return a;
        };
        var hero = function () { return document.querySelector('.detail .hero'); };
        var tag = function (el, vt) {
          if (!el) return;
          el.style.viewTransitionName = NAME;
          vt.finished.finally(function () { el.style.viewTransitionName = ''; });
        };
        window.addEventListener('pageswap', function (e) {
          if (!e.viewTransition || !e.activation || !e.activation.entry) return;
          var to = new URL(e.activation.entry.url).pathname;
          if (isList(location.pathname)) tag(cover(to), e.viewTransition);
          else if (isList(to)) tag(hero(), e.viewTransition);
        });
        window.addEventListener('pagereveal', function (e) {
          var act = window.navigation && navigation.activation;
          if (!e.viewTransition || !act || !act.from) return;
          var from = new URL(act.from.url).pathname;
          if (isList(location.pathname)) tag(cover(from), e.viewTransition);
          else if (isList(from)) tag(hero(), e.viewTransition);
        });
      })();
    </script>
    <script is:inline>
      // Embedded as the desktop detail panel (lib/detailOverlay.ts): drop the
      // site chrome, open links in the top window, relay Esc to the parent.
      (function () {
        var f = null;
        try { f = window.frameElement; } catch (e) {}
        if (!f || !f.hasAttribute('data-detail-frame')) return;
        document.documentElement.setAttribute('data-embed', '');
        var base = document.createElement('base');
        base.target = '_top';
        document.head.appendChild(base);
        window.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' || e.defaultPrevented) return;
          if (document.querySelector('.pswp')) return; // lightbox closes first
          parent.postMessage({ type: 'detail-overlay:close' }, location.origin);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var dark = window.matchMedia('(prefers-color-scheme: dark)');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') root.dataset.theme = t;
        } catch (e) {}
        // Keep the browser/status-bar tint on the page surface for the
        // resolved theme (explicit choice or system preference).
        function paint() {
          var isDark = root.dataset.theme ? root.dataset.theme === 'dark' : dark.matches;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', isDark ? '#121212' : '#f7f7f7');
        }
        // 'light' | 'dark' pin a theme; anything else follows the system.
        // `origin` ({x, y} in viewport px): reveal the new theme as a circle
        // growing from that point (View Transitions), e.g. the toggle button.
        window.__setTheme = function (next, origin) {
          var apply = function () { window.__applyTheme(next); };
          var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!origin || still || !document.startViewTransition) return apply();
          root.classList.add('theme-vt');
          var vt = document.startViewTransition(apply);
          vt.ready.then(function () {
            var r = Math.hypot(Math.max(origin.x, innerWidth - origin.x), Math.max(origin.y, innerHeight - origin.y));
            root.animate(
              { clipPath: ['circle(0px at ' + origin.x + 'px ' + origin.y + 'px)', 'circle(' + r + 'px at ' + origin.x + 'px ' + origin.y + 'px)'] },
              { duration: 520, easing: 'cubic-bezier(0.77, 0, 0.175, 1)', pseudoElement: '::view-transition-new(root)' }
            );
          });
          vt.finished.finally(function () { root.classList.remove('theme-vt'); });
        };
        window.__applyTheme = function (next) {
          try {
            if (next === 'dark' || next === 'light') {
              root.dataset.theme = next;
              localStorage.setItem('theme', next);
            } else {
              delete root.dataset.theme;
              localStorage.removeItem('theme');
            }
          } catch (e) {}
          paint();
        };
        paint();
        dark.addEventListener('change', paint);
      })();
    </script>
  </head>
  <body class:list={{ 'app-fill': wide, 'has-tabbar': tabbar }}>
    <IconSprite />
    <div class="statusbar-scrim" aria-hidden="true"></div>
    <Header />
    <main class:list={['main', { wide, detail }]}>
      <slot />
    </main>
    {tabbar && <TabBar />}
    <script>
      import { trackPage } from '../lib/navStack.ts';
      import '../lib/microInteractions.ts';
      trackPage();
      // Restored from the back/forward cache: scripts don't re-run, so note
      // which entry we're on again.
      addEventListener('pageshow', (e) => {
        if (e.persisted) trackPage();
      });
    </script>
  </body>
</html>

<style>
  .main {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) var(--space-8);
  }
  .main.detail {
    max-width: calc(1200px + 2 * var(--gutter));
  }

  /* Explorer pages: lock the app to the viewport so only the list scrolls —
     never the page itself. */
  :global(body.app-fill) {
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .main.wide {
    /* width:100% gives a definite cross-axis size so the flex column always
       stretches to the viewport. Without it, `margin:0 auto` disables stretch
       and the width becomes content-driven (differs per page). */
    width: 100%;
    max-width: var(--page-max);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    /* No vertical padding: the list and the filter sidebar run edge to edge
       (top and bottom) and fade out instead (MapShell); the map panel keeps
       its own inset. */
    padding-top: 0;
    padding-bottom: 0;
  }

  /* Phones: the explorer is a fixed full-screen app surface (map + sheet,
     see MapShell); nothing should rubber-band behind it. */
  @media (max-width: 760px) {
    :global(body.app-fill) {
      overscroll-behavior: none;
    }
    /* 1px of document scroll for the iOS status-bar tap (lib/mapExplorer.ts):
       everything visible is position: fixed, so this moves nothing. */
    :global(body.app-fill.sb-tap) {
      height: calc(100dvh + 1px);
      overflow: visible;
    }
    .main.wide {
      padding: 0;
    }
    .main:not(.wide) {
      padding-top: calc(env(safe-area-inset-top, 0px) + var(--space-4));
      padding-left: max(var(--space-4), env(safe-area-inset-left, 0px));
      padding-right: max(var(--space-4), env(safe-area-inset-right, 0px));
    }
  }
</style>
