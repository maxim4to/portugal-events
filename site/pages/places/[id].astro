---
import Base from '../../layouts/Base.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import Icon from '../../components/Icon.astro';
import MiniMap from '../../components/MiniMap.astro';
import VisitedButton from '../../components/VisitedButton.astro';
import VisitedController from '../../components/VisitedController.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import FavoriteController from '../../components/FavoriteController.astro';
import NotInterestedButton from '../../components/NotInterestedButton.astro';
import NotInterestedController from '../../components/NotInterestedController.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ReelEmbed from '../../components/ReelEmbed.astro';
import MobileDetailBar from '../../components/MobileDetailBar.astro';
import { allPlaces } from '../../lib/data.ts';
import { formatDriveMinutes, capitalize } from '../../lib/format.ts';
import { ICON_ROUTE, ICON_PIN } from '../../lib/actionIcons.ts';
import type { Place } from '../../../schema/index.ts';

export function getStaticPaths() {
  return allPlaces.map((place) => ({ params: { id: place.id }, props: { place } }));
}
const { place } = Astro.props as { place: Place };
const href = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
// Open the place itself on Google Maps (photos/reviews/hours), not just a pin.
// The id slug is the Portuguese/Latin name (e.g. "praia-da-arrifana"), which
// Google resolves far more reliably than the Cyrillic display name; anchor the
// search at the coords so it lands on the right object even for generic names.
const gmapsQuery = place.id.replace(/-/g, ' ');
const gmapsPlace = `https://www.google.com/maps/search/${encodeURIComponent(gmapsQuery)}/@${place.coords.lat},${place.coords.lon},16z`;
const paragraphs = place.description.split(/\n\n+/).map((s) => s.trim()).filter(Boolean);
const cover = place.photos[0];
const directions = `https://www.google.com/maps/dir/?api=1&destination=${place.coords.lat},${place.coords.lon}`;
// Scenic drives: a directions link that follows the road itself — start to
// end with a few mid-road via points so Google keeps the route on this road.
const road = place.routePath;
let driveRoad: string | null = null;
if (road && road.length > 1) {
  const pt = (p: { lat: number; lon: number }) => `${p.lat.toFixed(5)},${p.lon.toFixed(5)}`;
  const vias = [0.25, 0.5, 0.75].map((f) => pt(road[Math.floor(f * (road.length - 1))]));
  driveRoad =
    `https://www.google.com/maps/dir/?api=1&origin=${pt(road[0])}` +
    `&destination=${pt(road[road.length - 1])}` +
    `&waypoints=${encodeURIComponent(vias.join('|'))}`;
}

---
<Base title={place.name} description={place.description.slice(0, 150)} tabbar={false} detail>
  <article class="detail">
    <div class="d-head">
      <a class="back" href={href('/places/')}>
        <Icon name="arrow-left" size={16} /> Все места
      </a>

      <header class="head">
        <div class="kicker-row">
          <TypeBadge type={place.type} />
          <a class="region" href={href('/places/?region=' + encodeURIComponent(place.region))}>{place.region}</a>
        </div>
        <h1>{place.name}</h1>
      </header>
    </div>

    <div class="d-main">
      <figure class="hero">
        <PhotoGallery photos={place.photos} alt={place.name} variant="detail" type={place.type} />
        {cover && (
          <figcaption class="credit" data-gallery-attrib>
            Фото: <a href={cover.sourceUrl} target="_blank" rel="noopener">{cover.author}, {cover.license}</a>
          </figcaption>
        )}
      </figure>

      <div class="body">
        <div class="prose">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        {place.tags.length > 0 && (
          <div class="tags" aria-label="Теги">
            {place.tags.map((tag) => (
              <a class="chip tag" href={href('/places/?tag=' + encodeURIComponent(tag))}>{capitalize(tag)}</a>
            ))}
          </div>
        )}

        {place.links.length > 0 && (
          <section class="links">
            <h2 class="section-title">Ссылки</h2>
            <ul>
              {place.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.title}
                    <svg class="ext" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {place.reels.length > 0 && <ReelEmbed reels={place.reels} name={place.name} />}
      </div>
    </div>

    <aside class="d-aside" aria-label="Коротко о месте">
      <div class="panel">
        <dl class="facts">
          <div class="fact">
            <svg class="fact-ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 16V11.5l1.6-4.3A2 2 0 0 1 8.5 6h7a2 2 0 0 1 1.9 1.2l1.6 4.3V16" /><path d="M4 16h16v2.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5V18H7v.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5Z" /><path d="M5 11.5h14" /><circle cx="8" cy="14" r=".6" fill="currentColor" /><circle cx="16" cy="14" r=".6" fill="currentColor" /></svg>
            <dt>Дорога из Лиссабона</dt>
            <dd>{formatDriveMinutes(place.driveMinutesFromLisbon)}</dd>
          </div>
          <div class="fact">
            <Icon name="hourglass" size={20} class="fact-ico" />
            <dt>Время на месте</dt>
            <dd>~{place.visitDurationHours} ч</dd>
          </div>
          <div class="fact">
            <Icon name="calendar" size={20} class="fact-ico" />
            <dt>Лучший сезон</dt>
            <dd>{place.bestSeason}</dd>
          </div>
          {place.freeWithResidency === true && (
            <div class="fact">
              <svg class="fact-ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a2 2 0 0 0 2-2h12a2 2 0 0 0 2 2v8a2 2 0 0 0-2 2H6a2 2 0 0 0-2-2Z" /><path d="M10 6v12" stroke-dasharray="2 2" /></svg>
              <dt>Вход</dt>
              <dd>бесплатно с ВНЖ</dd>
            </div>
          )}
        </dl>

        <div class="actions">
          <a class="btn btn-primary act-main" href={driveRoad ?? directions} target="_blank" rel="noopener" data-dup-mbar={driveRoad ? undefined : ''}>
            <Fragment set:html={ICON_ROUTE} />
            {driveRoad ? 'Проехать дорогу в Google Maps' : 'Маршрут в Google Maps'}
          </a>
          <a class="btn act-secondary" href={gmapsPlace} target="_blank" rel="noopener"><Fragment set:html={ICON_PIN} />Открыть место в Google Maps</a>
          <div class="toggles">
            <FavoriteButton placeId={place.id} variant="detail" />
            <VisitedButton placeId={place.id} variant="detail" />
            <NotInterestedButton placeId={place.id} variant="detail" />
          </div>
        </div>
      </div>

      <div class="map-wrap">
        <MiniMap lat={place.coords.lat} lon={place.coords.lon} name={place.name} path={place.routePath} />
      </div>
    </aside>
  </article>

  <MobileDetailBar fallback={href('/places/')} title={place.name}>
    <div class="mbar-group">
      <FavoriteButton placeId={place.id} variant="card" />
      <VisitedButton placeId={place.id} variant="card" />
    </div>
    <a class="mbar-pill" href={directions} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 3.5 3.8 10.4c-.7.3-.6 1.3.1 1.5l6.6 1.6 1.6 6.6c.2.7 1.2.8 1.5.1z" />
      </svg>
      Маршрут
    </a>
  </MobileDetailBar>

  <VisitedController />
  <FavoriteController />
  <NotInterestedController />
</Base>

<style>
  /* ---- Single column (default, < 1100px) ----
     .d-main / .d-aside dissolve so their parts can be ordered: the facts panel
     follows the photo, the minimap closes the page. */
  .detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .d-head,
  .d-main,
  .d-aside {
    display: contents;
  }
  .back { order: 0; }
  .head { order: 1; }
  .hero { order: 2; }
  .panel { order: 3; }
  .body { order: 4; }
  .map-wrap { order: 5; }

  /* ---- Two columns (≥ 1100px): title across the top, then content +
     sticky aside whose top lines up with the photo. ---- */
  @media (min-width: 1100px) {
    .detail {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 384px;
      grid-template-areas:
        'head head'
        'main aside';
      gap: var(--space-5) var(--space-7);
      align-items: start;
      max-width: none;
    }
    .d-head {
      grid-area: head;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .d-head h1 {
      max-width: 880px;
    }
    .d-main {
      grid-area: main;
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      min-width: 0;
    }
    .d-aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
  }
  /* Sticky only when the whole aside fits the viewport. */
  @media (min-width: 1100px) and (min-height: 760px) {
    .d-aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
    }
  }

  /* ---- Head ---- */
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-bottom: calc(-1 * var(--space-2));
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    transition: color var(--dur-fast) ease;
  }
  .back:hover {
    color: var(--text-primary);
    text-decoration: none;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .kicker-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .region {
    color: var(--text-secondary);
    font-size: 13.5px;
    font-weight: 500;
  }
  .region:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .head h1 {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* ---- Photo ---- */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    min-width: 0;
  }
  .credit {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .credit a {
    color: inherit;
  }
  .credit a:hover {
    color: var(--text-secondary);
  }

  /* ---- Body ---- */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }
  .prose {
    max-width: 720px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-primary);
  }
  .prose p {
    margin: 0 0 var(--space-4);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag:hover {
    text-decoration: none;
  }
  .section-title {
    margin: 0 0 var(--space-3);
    font-size: 17px;
    font-weight: 600;
  }
  .links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--accent);
    font-size: 15px;
    font-weight: 500;
  }
  .links .ext {
    flex: none;
  }

  /* ---- Aside panel: facts + actions ---- */
  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    min-width: 0;
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
  }
  .fact {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: 2px;
    align-items: start;
  }
  .fact :global(.fact-ico) {
    grid-row: 1 / span 2;
    margin-top: 2px;
    color: var(--text-secondary);
  }
  .fact dt {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-secondary);
  }
  .fact dd {
    margin: 0;
    font-size: 15px;
    font-weight: 550;
    line-height: 1.4;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .actions .btn {
    width: 100%;
    min-height: 44px;
    white-space: normal;
    text-align: center;
  }
  .actions .btn :global(svg) {
    flex: none;
  }
  .toggles {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  /* ---- Minimap ---- */
  .map-wrap {
    min-width: 0;
  }
  .map-wrap :global(.minimap) {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 761px) and (max-width: 1099px) {
    .map-wrap :global(.minimap) {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---- Tablet (761–1099): facts read across, actions in a row ---- */
  @media (min-width: 761px) and (max-width: 1099px) {
    /* Three facts read across; four make a 2×2 (no orphan). */
    .facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-4) var(--space-5);
    }
    .facts:has(> :nth-child(4)) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .toggles {
      grid-column: 1 / -1;
    }
  }

  /* ---- Phone (≤ 760px) ----
     Photo edge-to-edge at the very top; back + favorite/visited + directions
     live in the floating MobileDetailBar, so their in-page twins go. */
  @media (max-width: 760px) {
    .detail {
      gap: var(--space-5);
      /* Clear the floating bar: 52px controls + 16px inset + 24px fade. */
      padding-bottom: calc(52px + var(--space-4) + 24px + var(--space-4) + env(safe-area-inset-bottom, 0px));
    }
    .back {
      display: none;
    }
    .hero {
      order: -1;
      margin: calc(-1 * (env(safe-area-inset-top, 0px) + var(--space-4))) calc(-1 * var(--gutter)) 0;
    }
    .hero :global(.gallery-detail) {
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
    .hero :global(.gallery-detail[data-count='0']) {
      aspect-ratio: 2 / 1;
    }
    .credit {
      padding: 0 var(--gutter);
    }
    .head {
      gap: var(--space-2);
    }
    .head h1 {
      font-size: clamp(28px, 7.6vw, 34px);
    }
    .prose {
      font-size: 16.5px;
    }
    .panel {
      padding: var(--space-4);
      gap: var(--space-4);
    }
    .facts {
      gap: var(--space-3);
    }
    .act-main[data-dup-mbar],
    .toggles :global(.favorite-btn),
    .toggles :global(.visited-btn) {
      display: none;
    }
    .actions .btn {
      min-height: 48px;
      font-size: 15px;
    }
    .toggles {
      margin-top: 0;
    }
    /* Only "not interested" is left: a full-width row like the other buttons. */
    .toggles :global(.ni-btn--detail) {
      flex-direction: row;
      min-height: 48px;
      font-size: 15px;
    }
    .tag {
      min-height: 36px;
    }
  }
</style>
