---
// "Профиль" tab: account, shortcuts into the user's own lists, appearance.
// Built for the phone tab bar, but works as a plain page on any screen.
import Base from '../layouts/Base.astro';

const href = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<Base title="Профиль — Португалия" description="Аккаунт и настройки">
  <div class="profile">
    <h1 class="large-title">Профиль</h1>

    <section class="group" data-p-auth hidden>
      <div class="account" data-p-out>
        <p class="acc-title">Войдите в аккаунт</p>
        <p class="acc-hint">Чтобы отмечать избранное и посещённые места — на всех устройствах.</p>
        <button type="button" class="google-btn" data-p-signin>
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
          </svg>
          Войти через Google
        </button>
      </div>
      <div class="account account-in" data-p-in hidden>
        <img class="avatar" data-p-avatar alt="" width="56" height="56" referrerpolicy="no-referrer" />
        <div class="who">
          <span class="name" data-p-name></span>
          <span class="email" data-p-email></span>
        </div>
      </div>
    </section>

    <section class="group-wrap" data-p-lists hidden>
      <p class="group-label">Мои места</p>
      <div class="group">
        <a class="row" href={href('/places/?fav=1')}>
          <span class="row-icon row-icon--fav" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 20s-7-4.6-9.3-9A4.9 4.9 0 0 1 12 6a4.9 4.9 0 0 1 9.3 5C19 15.4 12 20 12 20z" /></svg>
          </span>
          <span class="row-label">Избранное</span>
          <span class="row-value" data-p-count="favorites"></span>
          <span class="chev" aria-hidden="true"></span>
        </a>
        <a class="row" href={href('/places/?visited=visited')}>
          <span class="row-icon row-icon--visited" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
          </span>
          <span class="row-label">Посещённые</span>
          <span class="row-value" data-p-count="visited"></span>
          <span class="chev" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section class="group-wrap">
      <p class="group-label">Оформление</p>
      <div class="group group-pad">
        <div class="segmented" role="radiogroup" aria-label="Тема">
          <button type="button" role="radio" data-theme-opt="system">Авто</button>
          <button type="button" role="radio" data-theme-opt="light">Светлая</button>
          <button type="button" role="radio" data-theme-opt="dark">Тёмная</button>
        </div>
      </div>
    </section>

    <section class="group-wrap" data-p-signout-wrap hidden>
      <div class="group">
        <button type="button" class="row row-danger" data-p-signout>Выйти</button>
      </div>
    </section>
  </div>
</Base>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 560px;
    margin: 0 auto;
    padding-bottom: calc(var(--tabbar-h) + var(--space-5));
  }
  .large-title {
    margin: var(--space-2) 0 0;
    font-size: 34px;
  }
  .group {
    border-radius: 14px;
    background: var(--surface-2);
    border: 0.5px solid var(--border);
    overflow: hidden;
  }
  .group[hidden],
  .group-wrap[hidden],
  .account[hidden] {
    display: none;
  }
  .group-pad {
    padding: var(--space-3);
  }
  .group-label {
    margin: 0 0 var(--space-2) var(--space-4);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .account {
    padding: var(--space-4);
  }
  .acc-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 550;
  }
  .acc-hint {
    margin: 0 0 var(--space-4);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .google-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    height: 48px;
    border: 1px solid #dadce0;
    border-radius: 12px;
    background: #fff;
    color: #1f1f1f;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .google-btn:active {
    background: #f3f3f3;
  }
  .account-in {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-1);
  }
  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-size: 18px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .email {
    font-size: 14px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 52px;
    padding: 0 var(--space-4);
    border: 0;
    background: none;
    color: var(--text-primary);
    font: inherit;
    font-size: 16px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .row + .row {
    box-shadow: inset 0 0.5px 0 var(--border);
  }
  .row:hover {
    text-decoration: none;
  }
  .row:active {
    background: var(--surface-1);
  }
  .row-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: #fff;
  }
  .row-icon--fav {
    background: var(--danger);
  }
  .row-icon--visited {
    background: var(--visited);
  }
  .row-label {
    flex: 1;
  }
  .row-value {
    color: var(--text-muted);
  }
  .chev {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--text-muted);
    border-top: 2px solid var(--text-muted);
    transform: rotate(45deg);
    opacity: 0.7;
  }
  .row-danger {
    justify-content: center;
    color: var(--danger);
    font-weight: 600;
  }
  .segmented {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 3px;
    border-radius: 10px;
    background: var(--surface-1);
  }
  .segmented button {
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .segmented button[aria-checked='true'] {
    background: var(--surface-2);
    color: var(--text-primary);
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
  }
</style>

<script>
  import { onAuthChange, signInWithGoogle, signOutUser, isAuthConfigured } from '../lib/auth.ts';
  import { subscribeFavorites } from '../lib/favorites.ts';
  import { subscribeVisited } from '../lib/visited.ts';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const themeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-opt]'));
  const paintTheme = () => {
    const t = document.documentElement.dataset.theme || 'system';
    themeBtns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeOpt === t)));
  };
  themeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      (window as unknown as { __setTheme?: (t: string) => void }).__setTheme?.(b.dataset.themeOpt!);
      paintTheme();
    }),
  );
  paintTheme();

  if (isAuthConfigured()) {
    const out = $('[data-p-out]');
    const inBox = $('[data-p-in]');
    const lists = $('[data-p-lists]');
    const signoutWrap = $('[data-p-signout-wrap]');
    const avatar = $<HTMLImageElement>('[data-p-avatar]');
    $('[data-p-auth]').hidden = false;

    onAuthChange((user) => {
      out.hidden = !!user;
      inBox.hidden = !user;
      lists.hidden = !user;
      signoutWrap.hidden = !user;
      $('[data-p-name]').textContent = user?.displayName ?? '';
      $('[data-p-email]').textContent = user?.email ?? '';
      if (user?.photoURL) avatar.src = user.photoURL;
      else avatar.removeAttribute('src');
    });

    const count = (kind: string) => (ids: Set<string>) => {
      const el = document.querySelector<HTMLElement>(`[data-p-count="${kind}"]`);
      if (el) el.textContent = ids.size ? String(ids.size) : '';
    };
    subscribeFavorites(count('favorites'));
    subscribeVisited(count('visited'));

    $('[data-p-signin]').addEventListener('click', () => void signInWithGoogle());
    $('[data-p-signout]').addEventListener('click', () => void signOutUser());
  }
</script>
