---
import { capitalize } from '../lib/format.ts';
import { TAG_GLYPHS, TAG_FALLBACK_GLYPH } from '../lib/tagIcons.ts';
import { TYPE_LABELS } from '../lib/labels.ts';
import { typeDiscHtml } from '../lib/typeIcons.ts';
import Icon from './Icon.astro';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
const typeEntries = Object.entries(TYPE_LABELS);
// Region and tag lists come most-used first; the sidebar shows this many and
// folds the rest behind "Показать все" (selected ones always stay visible).
const SHOWN = 5;
const drivePresets = [
  { value: 60, label: 'до 1 ч' },
  { value: 120, label: 'до 2 ч' },
  { value: 180, label: 'до 3 ч' },
  { value: 240, label: 'любое' },
];

// Small stroke icons for the non-type options (types reuse the map's colored
// discs via typeDiscHtml, tying the filters to the pins). currentColor only,
// so they follow the chip's own state colors in both themes.
const ic = (body: string) =>
  `<span class="chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${body}</svg></span>`;

const CLOCK_ICON = ic('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>');
const RESIDENCY_ICON = ic('<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="11" r="2"/><path d="M5.5 16c.6-1.4 1.7-2.1 3-2.1s2.4.7 3 2.1M14 10h5M14 14h4"/>');
const NI_ICON = ic('<path d="M4 4l16 16"/><path d="M10.6 5.2A10 10 0 0 1 12 5c6 0 9.5 7 9.5 7a17 17 0 0 1-3.2 3.9M6.6 6.6A16.5 16.5 0 0 0 2.5 12s3.5 7 9.5 7c1.4 0 2.7-.4 4-1"/>');
const VISITED_ICON = ic('<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16.5 9"/>');
const UNVISITED_ICON = ic('<circle cx="12" cy="12" r="9" stroke-dasharray="3.2 3.2"/>');

---
<div class="filter-bar">
  {/* Sidebar mode only (wide desktop, see base.css): panel heading. */}
  <div class="fb-head">
    <span class="fb-title">Фильтры</span>
  </div>

  <button type="button" class="fav-toggle" data-favorites aria-pressed="false" aria-label="Показать избранное" hidden>
    <span class="fav-heart" aria-hidden="true"><Icon name="heart" size={15} /></span>
    <span class="flabel">Избранное</span><span class="fcount" data-fav-count></span>
  </button>

  <div class="fgroup" data-fgroup="drive">
    <button type="button" class="fgroup-summary" data-fgroup-toggle aria-expanded="false">
      <span class="flabel">Время в пути</span><span class="fcount" data-fcount></span>
    </button>
    <div class="fgroup-menu">
      {drivePresets.map((p) => (
        <button
          type="button"
          class="chip"
          data-drive={p.value}
          aria-pressed={p.value === 240 ? 'true' : 'false'}
        ><Fragment set:html={CLOCK_ICON} /><span class="chip-lab">{p.label}</span></button>
      ))}
    </div>
  </div>

  <div class="fgroup" data-fgroup="residency">
    <button type="button" class="fgroup-summary" data-fgroup-toggle aria-expanded="false">
      <span class="flabel">Вход</span><span class="fcount" data-fcount></span>
    </button>
    <div class="fgroup-menu">
      <button type="button" class="chip" data-residency aria-pressed="false">
        <Fragment set:html={RESIDENCY_ICON} /><span class="chip-lab">Бесплатно с ВНЖ</span>
      </button>
    </div>
  </div>

  <div class="fgroup" data-fgroup="type">
    <button type="button" class="fgroup-summary" data-fgroup-toggle aria-expanded="false">
      <span class="flabel">Тип</span><span class="fcount" data-fcount></span>
    </button>
    <div class="fgroup-menu">
      {typeEntries.map(([key, label]) => (
        <button type="button" class="chip" data-type={key} aria-pressed="false">
          <Fragment set:html={typeDiscHtml(key)} /><span class="chip-lab">{label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="fgroup" data-fgroup="tags">
    <button type="button" class="fgroup-summary" data-fgroup-toggle aria-expanded="false">
      <span class="flabel">Теги</span><span class="fcount" data-fcount></span>
    </button>
    <div class="fgroup-menu">
      {tags.map((t, i) => (
        <button type="button" class:list={['chip', { 'chip-extra': i >= SHOWN }]} data-tag={t} aria-pressed="false">
          <Fragment set:html={ic(TAG_GLYPHS[t] ?? TAG_FALLBACK_GLYPH)} /><span class="chip-lab">{capitalize(t)}</span>
        </button>
      ))}
      {tags.length > SHOWN && (
        <button type="button" class="fgroup-expand" data-expand aria-expanded="false">
          <span data-expand-more>Показать все · {tags.length}</span><span data-expand-less hidden>Свернуть</span>
        </button>
      )}
    </div>
  </div>

  <div class="fgroup" data-fgroup="more">
    <button type="button" class="fgroup-summary" data-fgroup-toggle aria-expanded="false">
      <span class="flabel">Ещё</span><span class="fcount" data-fcount></span>
    </button>
    <div class="fgroup-menu">
      <span class="visited-group" data-ni-filter-control hidden>
        <button type="button" class="chip" data-ni-hide aria-pressed="true">
          <Fragment set:html={NI_ICON} /><span class="chip-lab">Скрыть неинтересные</span>
        </button>
      </span>
      <span class="visited-group" data-visited-control data-filter="visited" hidden>
        <button type="button" class="chip" data-visited-opt="visited" aria-pressed="false">
          <Fragment set:html={VISITED_ICON} /><span class="chip-lab">Посещённые</span>
        </button>
        <button type="button" class="chip" data-visited-opt="unvisited" aria-pressed="true">
          <Fragment set:html={UNVISITED_ICON} /><span class="chip-lab">Непосещённые</span>
        </button>
      </span>
    </div>
  </div>

  <button type="button" class="reset-btn" data-reset hidden>Сбросить</button>
</div>

<style>
  /* Shared pill/dropdown/search/reset primitives live in base.css; the
     sidebar (facet) restyling lives there too, keyed off .has-sidebar. */
  .fb-head {
    display: none;
  }
  /* Sidebar mode (wide desktop): show the panel heading. The rest of the
     facet restyling keys off .has-sidebar in base.css. */
  @media (min-width: 1100px) {
    :global(.has-sidebar) .fb-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      min-height: 22px;
    }
  }
  .filter-bar {
    flex: 1 1 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .visited-group {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .visited-group[hidden] {
    display: none;
  }

  /* Favorites toggle — a pill matching the filter groups, with a heart. */
  .fav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--text-primary);
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  @media (hover: hover) {
    .fav-toggle:hover {
      border-color: var(--text-primary);
    }
  }
  .fav-toggle:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-bg);
  }
  .fav-heart {
    display: inline-flex;
    color: var(--text-secondary);
  }
  .fav-toggle[aria-pressed='true'] {
    border-color: var(--danger);
    background: color-mix(in srgb, var(--danger) 12%, var(--surface-2));
  }
  .fav-toggle[aria-pressed='true'] .fav-heart {
    color: var(--danger);
  }
  .fav-toggle[aria-pressed='true'] .fav-heart :global(svg) {
    fill: var(--danger);
  }
  .fav-toggle .fcount {
    background: var(--danger);
  }
  /* Hidden until signed in (the FavoriteController toggles this). The explicit
     display above would otherwise win over the `hidden` attribute. */
  .fav-toggle[hidden] {
    display: none;
  }
  /* «Ещё» holds only signed-in options: hide it while none of them shows. */
  .fgroup[data-fgroup='more']:not(:has(.fgroup-menu > :not([hidden]):not(.fgroup-done))) {
    display: none;
  }
  /* "Показать все" folds long lists — sidebar only; dropdowns and phone sheets
     show every option. */
  .fgroup-expand {
    display: none;
  }
  @media (min-width: 1100px) {
    :global(.has-sidebar) .fgroup:not(.expanded) .chip-extra:not([aria-pressed='true']) {
      display: none;
    }
    :global(.has-sidebar) .fgroup-expand {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 2px;
      padding: 6px 0;
      border: 0;
      background: none;
      color: var(--accent);
      font: inherit;
      font-size: 13.5px;
      font-weight: 550;
      cursor: pointer;
    }
    :global(.has-sidebar) .fgroup-expand:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>

<script>
  // Sidebar "Показать все / Свернуть" for long option lists.
  document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const group = btn.closest<HTMLElement>('.fgroup');
      if (!group) return;
      const open = group.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector<HTMLElement>('[data-expand-more]')!.hidden = open;
      btn.querySelector<HTMLElement>('[data-expand-less]')!.hidden = !open;
    });
  });
</script>
