---
import type { MapPoint } from '../lib/mapExplorer.ts';

interface Props {
  kind: 'places' | 'events';
  detailPrefix: string;
  hrefBase: string;
  mapId: string;
  points: MapPoint[];
  /** Hold the catalog hidden until the signed-in profile + its saved sets load,
      so the list paints once (already ordered) instead of reflowing. */
  awaitUser?: boolean;
}
const { kind, detailPrefix, hrefBase, mapId, points, awaitUser = false } = Astro.props;
---
<section
  class="explorer-root"
  data-explorer
  data-kind={kind}
  data-detail-prefix={detailPrefix}
  data-href-base={hrefBase}
  data-user-loading={awaitUser ? '' : undefined}
>
  <div class="filter-bar-top">
    {/* Phone-only: sort the list by distance from the visitor. */}
    <button type="button" class="near-pill" data-sort-near aria-pressed="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 3.5 3.8 10.4c-.7.3-.6 1.3.1 1.5l6.6 1.6 1.6 6.6c.2.7 1.2.8 1.5.1z" />
      </svg>
      Рядом
    </button>
    <slot name="filters" />
    <div class="toolbar">
      <slot name="toolbar" />
    </div>
  </div>

  <div class="map-explorer">
    <div class="pane pane-list" data-sheet>
      {/* Phone-only sheet header: grabber + live count. Hidden on desktop. */}
      <div class="sheet-head" data-sheet-handle>
        <span class="sheet-grabber" aria-hidden="true"></span>
        <div class="sheet-title-row">
          <span class="sheet-count" data-sheet-count aria-live="polite"></span>
          <button type="button" class="sheet-showall" data-show-all hidden>Все</button>
        </div>
      </div>
      <div class="list-scroll" data-list-scroll>
        <slot name="list" />
        <div class="empty" data-empty hidden>
          <p class="empty-title">Ничего не найдено</p>
          <p class="empty-hint">Попробуйте изменить фильтры или подвинуть карту.</p>
          <button type="button" class="btn empty-reset" data-reset>Сбросить фильтры</button>
        </div>
      </div>
    </div>

    <div class="pane pane-map">
      <div class="map" id={mapId} data-map></div>
    </div>
  </div>

  {/* Phone: tapping a pin docks a compact preview card here (see mapExplorer). */}
  <div class="pin-preview" data-pin-preview hidden></div>

  {/* Phone, list fully open: one floating pill back to the map. */}
  <button type="button" class="map-fab" data-to-map>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5L9 4z" />
      <path d="M9 4v13.5M15 6.5V20" />
    </svg>
    Карта
  </button>

  <script type="application/json" data-points set:html={JSON.stringify(points)}></script>

  {awaitUser && (
    <div class="catalog-loader" aria-hidden="true">
      <span class="catalog-spinner"></span>
    </div>
  )}
</section>

<style>
  .explorer-root {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  /* While waiting for the signed-in profile + saved sets, fade the content and
     show a centered spinner. Content stays laid out (opacity, not display:none)
     so the map still measures its pane. Revealed by removing the attribute
     (see lib/catalogReady.ts). */
  .explorer-root[data-user-loading] .filter-bar-top,
  .explorer-root[data-user-loading] .map-explorer,
  .explorer-root[data-user-loading] .map-fab {
    opacity: 0;
    pointer-events: none;
  }
  .filter-bar-top,
  .map-explorer,
  .map-fab {
    transition: opacity 0.2s ease;
  }
  .catalog-loader {
    display: none;
  }
  /* Fixed (not absolute): on mobile the explorer root is the full, page-tall
     scroll region, so an absolute overlay would center the spinner thousands of
     px down. Fixed keeps it in the middle of the viewport. */
  .explorer-root[data-user-loading] .catalog-loader {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 60;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .catalog-spinner {
    width: 28px;
    height: 28px;
    border: 2.5px solid var(--border-strong);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: catalog-spin 0.7s linear infinite;
  }
  @keyframes catalog-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalog-spinner {
      animation-duration: 1.4s;
    }
  }

  /* Compact full-width filter bar above the two panes. Sits above the card
     action buttons (z-index 5) so its dropdowns are never occluded. */
  .filter-bar-top {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) 0 var(--space-3);
  }
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }
  .sheet-head,
  .pin-preview,
  .map-fab,
  .near-pill {
    display: none;
  }

  /* Locate control + the visitor's blue dot (fixed iOS blue, so it reads on
     the always-light tiles in either theme). */
  :global(.locate-ctl.leaflet-bar) {
    border: 0 !important;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(33, 29, 23, 0.25);
    overflow: hidden;
  }
  :global(.locate-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: var(--surface-2);
    color: #0a84ff;
    cursor: pointer;
  }
  :global(.locate-btn[data-mode='follow'] svg) {
    fill: currentColor;
  }
  :global(.locate-btn[data-mode='locating'] svg) {
    animation: locate-pulse 1s ease-in-out infinite;
  }
  @keyframes locate-pulse {
    50% {
      opacity: 0.3;
    }
  }
  :global(.me-dot span) {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: #0a84ff;
    border: 3px solid #fff;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
  }
  :global(.me-dot::before) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #0a84ff;
    opacity: 0.35;
    animation: me-ping 2.4s ease-out infinite;
  }
  @keyframes me-ping {
    from {
      transform: scale(1);
      opacity: 0.4;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  :global(.me-halo) {
    stroke: #0a84ff;
    fill: #0a84ff;
    stroke-opacity: 0.3;
  }

  .map-explorer {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .pane {
    min-width: 0;
    min-height: 0;
  }
  .pane-list {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-strong);
  }
  .list-scroll {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-3);
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    color: var(--text-muted);
  }
  .empty[hidden] {
    display: none;
  }
  .empty-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .empty-hint {
    margin: 0;
    font-size: 14px;
  }
  .empty-reset {
    margin-top: var(--space-2);
  }
  .pane-map {
    position: relative;
    z-index: 0;
  }
  .map {
    width: 100%;
    height: 100%;
  }

  /* Active states for list↔map sync. Covers both the places layout (a .card
     nested inside the [data-item-card] wrapper) and events (where the
     [data-item-card] element is itself the .card). */
  :global(.explorer-root [data-item-card].is-active),
  :global(.explorer-root [data-item-card].is-active .card) {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }
  :global(.place-pin) {
    color: var(--accent);
  }
  :global(.place-pin svg) {
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
    transition: transform 0.12s ease;
    transform-origin: bottom center;
  }
  /* Highlight: scale the inner <svg>, not .place-pin itself — Leaflet owns the
     pin element's transform for positioning, so a transform there is ignored. */
  :global(.place-pin.pin-active) {
    color: var(--danger);
    z-index: 1000 !important;
  }
  :global(.place-pin.pin-active svg) {
    transform: scale(1.5);
  }

  /* Cluster bubble: count of the pins merged under it. */
  :global(.pin-cluster) {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  :global(.pin-cluster span) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(100% - 8px);
    height: calc(100% - 8px);
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
  }
  :global(:root[data-theme='dark']) :global(.pin-cluster span) {
    color: #0f1d33;
    border-color: #0f1d33;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) :global(.pin-cluster span) {
      color: #0f1d33;
      border-color: #0f1d33;
    }
  }

  /* Visited places: a dimmer pin so they recede behind unseen ones. Full
     opacity again while highlighted (hovered/selected). */
  :global(.place-pin--visited) {
    opacity: 0.4;
  }
  :global(.place-pin--visited.pin-active) {
    opacity: 1;
  }

  /* Favorites: a heart, always in the danger red (the pin-active red then just
     scales it). Highlighted state scales a touch more with a stronger shadow so
     a selected favorite stands out on the map. */
  :global(.place-pin--favorite) {
    color: var(--danger);
  }
  :global(.place-pin--favorite.pin-active svg) {
    transform: scale(1.5);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.45));
  }

  /* Dark theme: a dark basemap (inverted OSM tiles, hues restored), so the
     map matches the UI instead of glaring. */
  :global(:root[data-theme='dark']) .pane-map :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(0.88) saturate(0.7);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pane-map :global(.leaflet-tile-pane) {
      filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(0.88) saturate(0.7);
    }
  }

  /* Leaflet legibility with design tokens (esp. dark mode). */
  :global(.leaflet-container) {
    background: var(--surface-1);
    font: inherit;
  }
  :global(.leaflet-popup-content-wrapper),
  :global(.leaflet-popup-tip) {
    background: var(--surface-2);
    color: var(--text-primary);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }
  :global(.leaflet-popup-content) {
    margin: var(--space-2) var(--space-3);
    font-size: 14px;
  }
  :global(.leaflet-popup-content a) {
    color: var(--accent);
    font-weight: 500;
  }

  /* --- Rich editorial pin popup (see lib/mapExplorer.popupHtml) --- */
  :global(.map-pop-popup .leaflet-popup-content-wrapper) {
    padding: 0;
    overflow: hidden;
    border: 0.5px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 14px 36px rgba(33, 29, 23, 0.28);
  }
  /* Fixed width so every card is identical. Leaflet otherwise sets its own
     content width from the text's measured (nowrap) width; forcing `auto` here
     broke that, letting the popup shrink to a short title or stretch to a long
     line — hence the "floating" width. `!important` beats Leaflet's inline width. */
  :global(.map-pop-popup .leaflet-popup-content) {
    margin: 0;
    width: 240px !important;
    font-size: inherit;
  }
  /* Close button legible over the cover image. */
  :global(.map-pop-popup .leaflet-popup-close-button) {
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-2) 85%, transparent);
    color: var(--text-primary);
    box-shadow: 0 1px 4px rgba(33, 29, 23, 0.28);
    font-size: 16px;
    line-height: 1;
  }
  :global(.map-pop-popup .leaflet-popup-close-button:hover) {
    background: var(--surface-2);
  }
  :global(.map-pop) {
    display: block;
    color: var(--text-primary);
    text-decoration: none;
  }
  :global(.map-pop:hover) {
    text-decoration: none;
  }
  :global(.map-pop-media) {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--accent-bg);
    overflow: hidden;
  }
  :global(.map-pop-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.map-pop-body) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: var(--space-3);
  }
  :global(.map-pop-kicker) {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--editorial);
  }
  :global(.map-pop-title) {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 550;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  :global(.map-pop-meta) {
    font-size: 12px;
    color: var(--text-secondary);
  }
  :global(.map-pop-more) {
    margin-top: var(--space-1);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  :global(.map-pop:hover .map-pop-more) {
    text-decoration: underline;
  }
  :global(.leaflet-bar a),
  :global(.leaflet-bar a:hover) {
    background: var(--surface-2);
    color: var(--text-primary);
    border-color: var(--border);
  }
  :global(.leaflet-control-attribution) {
    background: color-mix(in srgb, var(--surface-2) 80%, transparent);
    color: var(--text-muted);
  }
  :global(.leaflet-control-attribution a) {
    color: var(--accent);
  }

  /* ---- Phone: full-screen map with the list in a draggable bottom sheet ----
     Geometry comes from lib/mobileSheet.ts via --sheet-y (sheet offset from
     the top), --map-cover (px of map hidden at the bottom) and --bar-h (filter
     bar height). */
  @media (max-width: 760px) {
    .explorer-root {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: var(--tabbar-h);
      overflow: hidden;
    }
    .map-explorer {
      position: absolute;
      inset: 0;
      display: block;
      border: 0;
      border-radius: 0;
    }
    .pane-map {
      position: absolute;
      inset: 0;
    }

    /* Filter bar: one compact row of floating pills over the map; a solid
       app bar over the list. Slides away while scrolling down the list. */
    .filter-bar-top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 45;
      flex-wrap: nowrap;
      gap: 0;
      padding: calc(env(safe-area-inset-top, 0px) + var(--space-2)) 0 var(--space-2);
      border-bottom: 0.5px solid transparent;
      transform: none;
      transition: transform 0.25s ease, background-color 0.2s ease, border-color 0.2s ease,
        opacity 0.2s ease;
      pointer-events: none;
    }
    .explorer-root.sheet-full .filter-bar-top {
      background: var(--surface-0);
      border-bottom-color: var(--border);
    }
    .explorer-root.sheet-full.hide-filter-bar .filter-bar-top {
      transform: translateY(-100%);
    }
    /* An open filter sheet must sit above the tab bar and everything else. */
    .filter-bar-top:has(.fgroup.open) {
      z-index: 1200;
      transform: none !important;
    }
    .toolbar:not(:has(*)) {
      display: none;
    }
    /* The whole bar is one horizontally scrolling row: "Рядом" + the page's
       filter pills (their wrapper dissolves into it). */
    .filter-bar-top {
      gap: var(--space-2);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding-left: var(--space-3);
      padding-right: var(--space-3);
      padding-bottom: 10px;
      pointer-events: auto;
    }
    .filter-bar-top::-webkit-scrollbar {
      display: none;
    }
    .filter-bar-top :global(.filter-bar),
    .filter-bar-top :global(.event-filters) {
      display: contents;
    }
    .near-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-sans);
      cursor: pointer;
    }
    .near-pill svg {
      color: #0a84ff;
    }
    .near-pill[aria-pressed='true'] {
      background: #0a84ff;
      border-color: #0a84ff;
      color: #fff;
    }
    .near-pill[aria-pressed='true'] svg {
      color: #fff;
      fill: currentColor;
    }

    /* The sheet. */
    .pane-list {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 100%;
      z-index: 30;
      border-right: 0;
      background: var(--surface-0);
      border-radius: 16px 16px 0 0;
      box-shadow: 0 -2px 18px rgba(33, 29, 23, 0.2);
      transform: translate3d(0, var(--sheet-y, 50%), 0);
      will-change: transform;
    }
    .explorer-root.sheet-anim .pane-list {
      transition: transform 0.34s cubic-bezier(0.2, 0.9, 0.25, 1), border-radius 0.2s ease;
    }
    .explorer-root.sheet-full .pane-list {
      border-radius: 0;
      box-shadow: none;
    }
    .sheet-head {
      display: block;
      flex: none;
      padding: var(--space-2) var(--space-4) var(--space-3);
      touch-action: none;
      cursor: grab;
      transition: padding 0.25s ease;
    }
    /* Bar tucked away: the sheet reaches the top edge, so clear the status bar. */
    .explorer-root.sheet-full.hide-filter-bar .sheet-head {
      padding-top: calc(env(safe-area-inset-top, 0px) + var(--space-2));
    }
    .sheet-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      min-height: 28px;
      margin-top: var(--space-2);
    }
    .sheet-count {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .sheet-showall {
      padding: 4px 0;
      border: 0;
      background: none;
      color: var(--accent);
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .sheet-showall[hidden] {
      display: none;
    }
    .list-scroll {
      overflow: hidden;
      overscroll-behavior: contain;
      /* The sheet hangs --bar-h below the screen while fully open. */
      padding: 0 var(--space-3) calc(var(--bar-h, 56px) + 96px);
    }
    .explorer-root.sheet-full .list-scroll {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    /* Shorter card photos, so a half-open sheet already shows a place name. */
    .list-scroll :global(.gallery-card),
    .list-scroll :global(.event-card .cover) {
      aspect-ratio: 16 / 9;
    }
    .explorer-root.sheet-away .pane-list {
      box-shadow: none;
    }

    /* Leaflet controls ride just above whatever covers the map's bottom edge,
       and just below the floating filter row at the top. */
    .pane-map :global(.leaflet-bottom) {
      bottom: var(--map-cover, 0px);
      transition: bottom 0.34s cubic-bezier(0.2, 0.9, 0.25, 1);
    }
    .explorer-root.sheet-dragging .pane-map :global(.leaflet-bottom) {
      transition: none;
    }
    .pane-map :global(.leaflet-top) {
      top: var(--bar-h, 56px);
    }
    .pane-map :global(.leaflet-control-zoom) {
      display: none;
    }
    /* Fractional zoom leaves hairline seams between tiles; additive blending
       makes the anti-aliased tile edges sum back to opaque. */
    .pane-map :global(img.leaflet-tile) {
      mix-blend-mode: plus-lighter;
    }
    .pane-map :global(.leaflet-control-attribution) {
      font-size: 9px;
    }

    /* "Карта" pill over the open list. */
    .map-fab {
      position: absolute;
      left: 50%;
      bottom: var(--space-4);
      z-index: 50;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      height: 44px;
      padding: 0 var(--space-5);
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--text-primary);
      color: var(--surface-2);
      font: inherit;
      font-size: 15px;
      font-weight: 600;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
      cursor: pointer;
      transform: translate(-50%, 0);
      transition: transform 0.25s ease, opacity 0.2s ease;
    }
    .explorer-root:not(.sheet-full) .map-fab {
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 20px);
    }
    .map-fab:active {
      transform: translate(-50%, 0) scale(0.96);
    }

    /* Pin preview card, docked at the bottom while the sheet is away. */
    .pin-preview:not([hidden]) {
      position: absolute;
      left: var(--space-3);
      right: var(--space-3);
