---
interface Props {
  placeId: string;
  variant?: 'card' | 'detail';
}
const { placeId, variant = 'detail' } = Astro.props;
---
<button
  type="button"
  class:list={['ni-btn', `ni-btn--${variant}`, { 'icon-tip': variant === 'card' }]}
  data-ni-id={placeId}
  data-tip="Не интересно"
  data-tip-on="Скрыто"
  aria-pressed="false"
  aria-label="Не интересно"
  hidden
>
  {/* Not-interested: a slashed circle ("no"). Pressed: the same circle filled,
      the slash cut out in the surface colour. Swapped purely by aria-pressed. */}
  <svg class="ni-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-ni" /></svg>
  <svg class="ni-icon-on" width="18" height="18" fill="none" aria-hidden="true"><use href="#i-ni-on" /></svg>
  <span class="ni-label">Не интересно</span>
</button>

<style>
  .ni-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 550;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .ni-btn:hover {
    border-color: var(--border-strong);
  }
  .ni-btn:active {
    transform: scale(0.94);
  }
  /* Pressed = not interested: the slashed circle fills in the muted grey. */
  .ni-btn[aria-pressed='true'] {
    color: var(--not-interested);
    border-color: var(--not-interested);
  }
  .ni-btn[aria-pressed='true'] .ni-icon-on {
    animation: toggle-pop 180ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ni-icon,
  .ni-icon-on {
    flex: none;
  }
  .ni-icon-on {
    display: none;
  }
  .ni-btn[aria-pressed='true'] .ni-icon {
    display: none;
  }
  .ni-btn[aria-pressed='true'] .ni-icon-on {
    display: block;
  }

  /* Detail page: equal-width secondary tiles (icon over a sentence-case
     label) that share one row in the aside, however many are visible. */
  .ni-btn--detail {
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    min-height: 64px;
    padding: var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-primary);
    font-size: 12.5px;
    font-weight: 550;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .ni-btn--detail[hidden] {
    display: none;
  }
  @media (hover: hover) {
    .ni-btn--detail:hover {
      border-color: var(--text-primary);
    }
  }
  .ni-btn--detail:active {
    transform: scale(0.97);
  }
  .ni-btn--detail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: none;
  }
  .ni-btn--detail[aria-pressed='true'] {
    color: var(--not-interested, var(--text-muted));
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, var(--surface-2));
  }
  .ni-btn--detail .ni-label {
    max-width: 100%;
  }

  /* Compact circular overlay for catalog cards. Mirrors the visited/favorite
     card buttons exactly — same shell, only the icon and pressed tint differ. */
  .ni-btn--card {
    width: 32px;
    height: 32px;
    padding: 0;
    justify-content: center;
    border-radius: var(--radius-pill);
    min-height: 0;
    border: 0;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-2) 85%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-md);
  }
  .ni-btn--card .ni-icon,
  .ni-btn--card .ni-icon-on {
    width: 18px;
    height: 18px;
  }
  /* Icon-only on cards: meaning carried by the hover tip, not a label. */
  .ni-btn--card .ni-label {
    display: none;
  }
  .ni-btn--card[aria-pressed='true'] {
    color: var(--not-interested);
    border-color: var(--not-interested);
  }
  /* Bigger tap target on phones — 32px is fiddly under a finger. */
  @media (max-width: 760px) {
    .ni-btn--card {
      width: 44px;
      height: 44px;
    }
    .ni-btn--card .ni-icon,
    .ni-btn--card .ni-icon-on {
      width: 22px;
      height: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-btn {
      transition: none;
    }
    .ni-btn:active {
      transform: none;
    }
    .ni-btn[aria-pressed='true'] .ni-icon-on {
      animation: none;
    }
  }
</style>
