---
interface Props {
  placeId: string;
  variant?: 'card' | 'detail';
}
const { placeId, variant = 'detail' } = Astro.props;
---
<button
  type="button"
  class:list={['ni-btn', `ni-btn--${variant}`, { 'icon-tip': variant === 'card' }]}
  data-ni-id={placeId}
  aria-pressed="false"
  aria-label="Не интересно"
  hidden
>
  {/* Not-interested: a slashed circle ("no"). Pressed: the same circle filled,
      the slash cut out in the surface colour. Swapped purely by aria-pressed. */}
  <span class="act-ico">
    <svg class="ni-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-ni" /></svg>
    <svg class="ni-icon-on" width="18" height="18" fill="none" aria-hidden="true"><use href="#i-ni-on" /></svg>
  </span>
  <span class="ni-label">Не интересно</span>
</button>

<style>
  .ni-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 550;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .ni-btn:hover {
    border-color: var(--border-strong);
  }
  .ni-btn:active {
    transform: scale(0.94);
  }
  /* Pressed = not interested: the slashed circle fills in the muted grey. */
  .ni-btn[aria-pressed='true'] {
    color: var(--not-interested);
    border-color: var(--not-interested);
  }
  .ni-btn[aria-pressed='true'] .ni-icon-on {
  }
  .ni-icon,
  .ni-icon-on {
    flex: none;
  }
  .ni-icon-on {
    display: none;
  }
  .ni-btn[aria-pressed='true'] .ni-icon {
    display: none;
  }
  .ni-btn[aria-pressed='true'] .ni-icon-on {
    display: block;
  }

  /* Card / bar variants: the icon wrapper is transparent to layout. */
  .act-ico {
    display: contents;
  }

  /* Detail page: tactile tiles that share one row in the aside. Each has its
     own tone (heart red, visited green, not-interested grey) shown in a soft
     icon well; the tile sits slightly raised (sheen + shadow), lifts on hover
     and presses into the page on click. On = tinted tile, solid tone well. */
  .ni-btn--detail {
    --tone: var(--not-interested);
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 80px;
    padding: 10px 6px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-2);
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      0 1px 2px rgb(0 0 0 / 0.06),
      0 3px 8px rgb(0 0 0 / 0.04);
    color: var(--text-primary);
    font-size: 12.5px;
    font-weight: 550;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    transition:
      transform 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out),
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .ni-btn--detail[hidden] {
    display: none;
  }
  .ni-btn--detail .act-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tone) 13%, transparent);
    color: var(--tone);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .ni-btn--detail .act-ico svg {
    grid-area: 1 / 1;
  }
  @media (hover: hover) {
    .ni-btn--detail:hover {
      transform: translateY(-1px);
      border-color: var(--border-strong);
      box-shadow:
        inset 0 1px 0 var(--edge-highlight),
        0 2px 4px rgb(0 0 0 / 0.06),
        0 8px 18px rgb(0 0 0 / 0.08);
    }
    .ni-btn--detail:hover .act-ico {
      background: color-mix(in srgb, var(--tone) 20%, transparent);
    }
  }
  .ni-btn--detail:active {
    transform: translateY(1px) scale(0.98);
    box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.14);
    transition-duration: 80ms;
  }
  .ni-btn--detail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: none;
  }
  .ni-btn--detail[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--tone) 45%, transparent);
    background: color-mix(in srgb, var(--tone) 8%, var(--surface-2));
    color: color-mix(in srgb, var(--tone) 70%, var(--text-primary));
  }
  .ni-btn--detail[aria-pressed='true'] .act-ico {
    background: var(--tone);
    color: #fff;
  }
  .ni-btn--detail .ni-label {
    max-width: 100%;
  }
  .ni-btn--detail[aria-pressed='true'] .ni-icon {
    display: block;
  }
  .ni-btn--detail[aria-pressed='true'] .ni-icon-on {
    display: none;
  }

  /* Compact circular overlay for catalog cards. Mirrors the visited/favorite
     card buttons exactly — same shell, only the icon and pressed tint differ. */
  .ni-btn--card {
    /* Icon-only circle at rest; on hover its label unfurls to the left
       (see .icon-tip in base.css), so the width is content-driven. */
    min-width: 32px;
    height: 32px;
    padding: 0 7px;
    gap: 0;
    justify-content: center;
    border-radius: var(--radius-pill);
    min-height: 0;
    border: 0;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-2) 85%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-md);
  }
  .ni-btn--card .ni-icon,
  .ni-btn--card .ni-icon-on {
    width: 18px;
    height: 18px;
  }
  .ni-btn--card[aria-pressed='true'] {
    color: var(--not-interested);
    border-color: var(--not-interested);
  }
  /* Bigger tap target on phones — 32px is fiddly under a finger. */
  @media (max-width: 760px) {
    .ni-btn--card {
      min-width: 44px;
      height: 44px;
      padding: 0 11px;
    }
    .ni-btn--card .ni-icon,
    .ni-btn--card .ni-icon-on {
      width: 22px;
      height: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-btn {
      transition: none;
    }
    .ni-btn:active {
      transform: none;
    }
    .ni-btn[aria-pressed='true'] .ni-icon-on {
      animation: none;
    }
  }
</style>
