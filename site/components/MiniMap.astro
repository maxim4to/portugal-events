---
interface Props {
  lat: number;
  lon: number;
  name: string;
  // Scenic-drive places: the road's own polyline, drawn in a second colour on
  // top of the Lisbon approach route.
  path?: { lat: number; lon: number }[];
}
const { lat, lon, name, path } = Astro.props;
---
<div
  class="minimap"
  data-lat={lat}
  data-lon={lon}
  data-name={name}
  data-path={path && path.length > 1 ? JSON.stringify(path.map((p) => [p.lat, p.lon])) : undefined}
></div>

<style>
  /* The point in context relative to Lisbon. Pages may override the ratio. */
  .minimap {
    /* Own stacking context: Leaflet's panes/controls carry z-indexes up to
       1000 and would otherwise paint over the page's floating bars. */
    position: relative;
    z-index: 0;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    overflow: hidden;
  }
  /* Scoped container bg so tiles load onto a token-aware surface (dark mode).
     Global Leaflet popup/control overrides already live in the catalog. */
  .minimap:global(.leaflet-container) {
    background: var(--surface-1);
    font: inherit;
  }
  /* Tiles and overlays fade in together once the first tiles are loaded. */
  .minimap :global(.leaflet-map-pane) {
    opacity: 0;
    transition: opacity 360ms var(--ease-out);
  }
  .minimap:global(.is-ready) :global(.leaflet-map-pane) {
    opacity: 1;
  }
  /* Same basemap grading as the explorer (MapShell): warm parchment in
     light, inverted dark map in dark. Only the tile pane is filtered, so the
     route, pins and labels keep their own colors on top. */
  .minimap :global(.leaflet-tile-pane) {
    filter: saturate(0.82) brightness(1.03) contrast(0.95);
  }
  :global(:root[data-theme='dark']) .minimap :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(0.88) saturate(0.7);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .minimap :global(.leaflet-tile-pane) {
      filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(0.88) saturate(0.7);
    }
  }
  /* Zoom buttons: one rounded card, per DESIGN.md. leaflet.css is imported
     from JS and loads after this, so overrides carry .leaflet-container to win. */
  .minimap:global(.leaflet-container) :global(.leaflet-bar) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .minimap:global(.leaflet-container) :global(.leaflet-bar a) {
    width: 36px;
    height: 36px;
    line-height: 36px;
    background: var(--surface-2);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
  }
  .minimap:global(.leaflet-container) :global(.leaflet-bar a:last-child) {
    border-bottom: 0;
  }
  .minimap:global(.leaflet-container) :global(.leaflet-bar a:hover) {
    background: var(--surface-1);
  }
  .minimap:global(.leaflet-container) :global(.leaflet-control-attribution) {
    font-size: 10px;
  }
  /* No hairline seams between tiles: leaflet.css blends tiles with
     plus-lighter, which whitens their edges at fractional zoom. */
  .minimap:global(.leaflet-container) :global(.leaflet-tile) {
    mix-blend-mode: normal;
  }
  .minimap :global(.leaflet-tile-container .leaflet-tile) {
    width: 257px !important;
    height: 257px !important;
  }
  /* Touch screens: reserve one-finger vertical drags for page scroll; the JS
     disables one-finger map dragging so only two-finger gestures pan/zoom. */
  @media (pointer: coarse) {
    .minimap:global(.leaflet-container) {
      touch-action: pan-y;
    }
  }
  /* Map overlays sit on always-light OSM tiles, so they use a fixed, saturated
     colour + white halo instead of the theme accent (which goes pale-blue in
     dark mode and washes out against the tiles). */
  .minimap {
    --map-accent: #d1341f;
    --map-road: #1d5bbf;
    --map-halo: #ffffff;
  }
  .minimap :global(.place-pin) {
    color: var(--map-accent);
  }
  .minimap :global(.place-pin svg) {
    display: block;
    /* White outline + soft shadow so the pin reads on any tile. */
    filter: drop-shadow(0 0 1px var(--map-halo))
      drop-shadow(0 0 1px var(--map-halo)) drop-shadow(0 2px 3px rgba(0, 0, 0, 0.45));
  }
  /* Small editorial label — used for the Lisbon anchor and the point of
     interest alike, so both read as the same quiet chip. */
  .minimap :global(.lisbon-tip),
  .minimap :global(.place-tip) {
    background: var(--surface-2);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: 2px var(--space-2);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }
  .minimap :global(.lisbon-tip::before),
  .minimap :global(.place-tip::before) {
    display: none;
  }
  /* Long names stay on one line (ellipsis) so the label never covers the
     route; the full name is the page title right above. */
  .minimap :global(.place-tip) {
    max-width: 200px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  /* Route + connector colours via CSS (CSS stroke/fill resolve tokens and win
     over Leaflet's presentation attributes). */
  .minimap :global(.route-line) {
    stroke: var(--map-accent);
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
  }
  /* White casing drawn under the route so it separates from the tiles. */
  .minimap :global(.route-casing) {
    stroke: var(--map-halo);
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
  }
  .minimap :global(.route-line--dashed) {
    opacity: 0.9;
  }
  /* The scenic road itself (type "route") — a second colour so it reads apart
     from the red Lisbon approach. */
  .minimap :global(.road-line) {
    stroke: var(--map-road);
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
  }
  .minimap :global(.road-dot) {
    stroke: var(--map-road);
    stroke-width: 3;
    fill: var(--map-halo);
  }
  .minimap :global(.lisbon-dot) {
    stroke: var(--map-accent);
    stroke-width: 3;
    fill: var(--map-halo);
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import L from 'leaflet';
  import { addBasemap } from '../lib/mutedTiles.ts';

  // Central Lisbon — the trips all start here (see project design doc).
  const LISBON = { lat: 38.7223, lon: -9.1393 };
  // Portugal-only site: keep the map on mainland Portugal plus a margin (same
  // frame as the explorer map, see PT_VIEW_BOUNDS in mapExplorer.ts).
  const PT_VIEW_BOUNDS = L.latLngBounds([35.7, -11.6], [43.3, -4.6]);
  const PT_BOX = L.latLngBounds([36.7, -9.85], [42.16, -6.18]);

  const el = document.querySelector<HTMLElement>('.minimap');
  if (el && !el.dataset.ready) {
    el.dataset.ready = '1';
    const lat = Number(el.dataset.lat);
    const lon = Number(el.dataset.lon);
    const name = el.dataset.name || '';
    // Scenic road polyline ([lat, lon] pairs), present only on "route" places.
    let road: [number, number][] = [];
    try {
      road = JSON.parse(el.dataset.path || '[]');
    } catch {
      road = [];
    }

    const PIN_HTML =
      '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.6 7.3 11.9a1 1 0 0 0 1.4 0C13 21.6 20 15.4 20 10c0-4.4-3.6-8-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>';
    const pinIcon = L.divIcon({
      className: 'place-pin',
      html: PIN_HTML,
      iconSize: [24, 24],
      iconAnchor: [12, 22],
      popupAnchor: [0, -20],
    });

    // On touch screens, one-finger drag should scroll the page, not pan the
    // map — only a two-finger gesture (Leaflet's touch-zoom, which also pans)
    // interacts with the map. Desktop mouse dragging is unaffected.
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const map = L.map(el, {
      scrollWheelZoom: false,
      dragging: !coarse,
      // Touch screens pinch; the +/- buttons are just clutter there.
      zoomControl: !coarse,
      // Fractional zoom so the padded framing doesn't drop a whole level.
      zoomSnap: 0.25,
      maxBounds: PT_VIEW_BOUNDS,
      maxBoundsViscosity: 1,
      // Placeholder view so layers can be added; replaced (without animation,
      // while the pane is still hidden) by the real framing below.
    }).setView([lat, lon], 8);
    // Min zoom: where mainland Portugal fits the box, a quarter-step out.
    const syncMinZoom = () => {
      const fit = map.getBoundsZoom(PT_BOX, false, L.point(32, 32));
      const z = Math.floor(fit * 4) / 4 - 0.25;
      map.setMinZoom(z);
      if (map.getZoom() < z) map.setZoom(z, { animate: false });
    };
    map.on('resize', syncMinZoom);
    // Drop Leaflet's own attribution prefix (which carries a 🇺🇦 flag); keep the
    // basemap credit added below.
    map.attributionControl.setPrefix(false);
    if (coarse) {
      // Let the browser own vertical scroll gestures; two-finger gestures still
      // reach Leaflet (which preventDefaults them) so pinch/pan work.
      el.style.touchAction = 'pan-y';
    }
    const tiles = addBasemap(map);

    // The destination pin (the only real pin on the map), labelled like the
    // Lisbon anchor so the point of interest is named on the map.
    L.marker([lat, lon], { icon: pinIcon, title: name })
      .addTo(map)
      .bindTooltip(name, {
        permanent: true,
        direction: 'top',
        className: 'place-tip',
        offset: [0, -22],
      });

    // A subtle Lisbon anchor so the destination reads relative to it — a small
    // dot + label rather than a competing pin.
    // The route lives in the overlay pane; the Lisbon dot gets a pane above it
    // so the line runs under the dot instead of across it.
    const pointsPane = map.createPane('points');
    pointsPane.style.zIndex = '450';

    L.circleMarker([LISBON.lat, LISBON.lon], {
      pane: 'points',
      radius: 5,
      weight: 2,
      fillOpacity: 1,
      className: 'lisbon-dot',
    })
      .addTo(map)
      .bindTooltip('Лиссабон', {
        permanent: true,
        direction: 'top',
        className: 'lisbon-tip',
        offset: [0, -6],
      });

    // The scenic road itself, in its own colour over a white casing, with
    // start/end dots. Drawn before the Lisbon approach is fetched so the road
    // is visible even if OSRM is down.
    if (road.length > 1) {
      L.polyline(road, { weight: 9, className: 'route-casing' }).addTo(map);
      L.polyline(road, { weight: 5, className: 'road-line' }).addTo(map);
      for (const end of [road[0], road[road.length - 1]]) {
        L.circleMarker(end, {
          pane: 'points',
          radius: 4,
          weight: 2,
          fillOpacity: 1,
          className: 'road-dot',
        }).addTo(map);
      }
    }

    // Frame both Lisbon and the destination; refined once a route is drawn.
    const bothBounds = L.latLngBounds([
      [LISBON.lat, LISBON.lon],
      [lat, lon],
    ]);
    if (road.length > 1) for (const p of road) bothBounds.extend(p);
    // Leave room for the labels: they sit above both points (the destination
    // one can be ~200px wide and up to three lines tall), so pad the top and
    // sides more than the bottom.
    // Scale the padding with the box (aside ≈ 360×225, wide ≈ 760×430) so a
    // small map doesn't zoom out to fit room reserved for a big one.
    const side = Math.round(Math.min(90, el.clientWidth * 0.2));
    // The destination label sits above its pin (one line).
    const top = Math.round(Math.min(64, el.clientHeight * 0.3));
    const bottom = Math.round(Math.min(28, el.clientHeight * 0.1));
    const FIT = {
      paddingTopLeft: [side, top] as L.PointTuple,
      paddingBottomRight: [side, bottom] as L.PointTuple,
    };
    // First paint at the final framing — no zoom-in from a default view. The
    // box is padded a little so the real route (usually a bit wider than the
    // straight line) lands inside it and the camera never has to move.
    const initial = bothBounds.pad(0.12);
    map.fitBounds(initial, { ...FIT, animate: false });
    syncMinZoom();

    // Reveal the map once its first tiles are in, instead of a grey box that
    // pops tile by tile (CSS fades .is-ready in).
    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      el.classList.add('is-ready');
    };
    tiles.once('load', reveal);
    window.setTimeout(reveal, 1500);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Draw a polyline on like a pen stroke (SVG dash offset). Starts from the
    // Lisbon end because the geometry runs Lisbon → destination.
    const drawOn = (layer: L.Path | L.GeoJSON, ms: number, delay = 0) => {
      if (reduced) return;
      const paths: SVGPathElement[] = [];
      const collect = (l: L.Layer) => {
        const e = (l as L.Path).getElement?.() as SVGPathElement | undefined;
        if (e) paths.push(e);
      };
      if ('eachLayer' in layer) (layer as L.GeoJSON).eachLayer(collect);
      else collect(layer);
      for (const path of paths) {
        const len = path.getTotalLength();
        path.animate(
          [{ strokeDasharray: `${len}`, strokeDashoffset: `${len}` }, { strokeDasharray: `${len}`, strokeDashoffset: '0' }],
          { duration: ms, delay, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'backwards' },
        );
      }
    };
    // Only move the camera if the route really doesn't fit — and then glide.
    const ensureVisible = (b: L.LatLngBounds) => {
      if (map.getBounds().contains(b)) return;
      if (reduced) map.fitBounds(b.extend(bothBounds), { ...FIT, animate: false });
      else map.flyToBounds(b.extend(bothBounds), { ...FIT, duration: 0.6, easeLinearity: 0.35 });
    };

    // Try to draw the actual driving route (OSRM demo). If anything fails, the
    // straight-line framing above already shows the point relative to Lisbon.
    // For a scenic road, approach its first point (the end nearest Lisbon)
    // rather than the mid-road pin.
    const dest = road.length > 1 ? { lat: road[0][0], lon: road[0][1] } : { lat, lon };
    const url =
      `https://router.project-osrm.org/route/v1/driving/` +
      `${LISBON.lon},${LISBON.lat};${dest.lon},${dest.lat}` +
      `?overview=full&geometries=geojson`;

    fetch(url)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('route http ' + r.status))))
      .then((data) => {
        const geo = data?.routes?.[0]?.geometry;
        if (!geo || geo.type !== 'LineString') throw new Error('no route geometry');
        // White casing first, then the coloured route on top, so the line
        // stays legible over any map tiles.
        const casing = L.geoJSON(geo, {
          style: { weight: 8, opacity: 1, className: 'route-casing' },
        }).addTo(map);
        const line = L.geoJSON(geo, {
          style: { weight: 4, opacity: 1, className: 'route-line' },
        }).addTo(map);
        ensureVisible(line.getBounds());
        drawOn(casing, 900);
        drawOn(line, 900, 40);
      })
      .catch(() => {
        // Fallback: a faint straight connector so the direction is still legible.
        L.polyline(
          [
            [LISBON.lat, LISBON.lon],
            [dest.lat, dest.lon],
          ],
          { weight: 3, dashArray: '6 7', className: 'route-line route-line--dashed' },
        ).addTo(map);
        ensureVisible(bothBounds);
      });
  }
</script>
