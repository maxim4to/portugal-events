---
import type { Place } from '../../schema/index.ts';
import { TYPE_LABELS } from '../lib/labels.ts';
import Icon from './Icon.astro';
import PhotoGallery from './PhotoGallery.astro';
import { formatDriveMinutes, shortSeason } from '../lib/format.ts';

interface Props {
  place: Place;
  href: string;
}
const { place, href } = Astro.props;
const typeLabel = TYPE_LABELS[place.type] ?? place.type;
---
<a href={href} class="card place-card" data-card-link>
  <div class="cover">
    <PhotoGallery photos={place.photos} alt={place.name} variant="card" type={place.type} />
  </div>
  <div class="body">
    <span class="kicker type-kicker">
      <span class="type-dot" style={`background: var(--type-${place.type}-text);`} aria-hidden="true"></span>
      {typeLabel}
    </span>
    <h3>{place.name}</h3>
    <p class="desc">{place.description}</p>
    {place.freeWithResidency === true && (
      <span class="residency-pill">Бесплатно с ВНЖ</span>
    )}
    <div class="meta-row">
      <span class="dist" data-dist hidden></span>
      <span><Icon name="clock" size={12} /> {formatDriveMinutes(place.driveMinutesFromLisbon)}</span>
      <span><Icon name="hourglass" size={12} /> ~{place.visitDurationHours} ч</span>
      <span class="season" title={place.bestSeason}><Icon name="calendar" size={12} /> {shortSeason(place.bestSeason)}</span>
    </div>
  </div>
</a>

<style>
  /* Photo-first card (DESIGN.md): no frame, rounded cover, text below. */
  .place-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
    text-decoration: none;
    color: inherit;
  }
  .place-card:hover {
    text-decoration: none;
  }
  .cover {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-1);
    isolation: isolate;
    transition: box-shadow var(--dur) var(--ease-out);
  }
  /* Desktop: 4:3 covers, the same shape as event cards (DESIGN.md). */
  @media (min-width: 761px) {
    .cover :global(.gallery-card) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (hover: hover) {
    .place-card:hover .cover {
      box-shadow: var(--shadow-md);
    }
    .place-card:hover h3 {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
    padding: 0 2px;
    container-type: inline-size;
  }
  /* Too narrow for the season to say anything useful ("се…"): drop it — the
     detail page shows it in full. */
  @container (max-width: 205px) {
    .body .meta-row > span.season.season {
      display: none;
    }
  }
  .type-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .type-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .body h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Always reserve two lines so cards in a row align their footers. */
    min-height: 3em;
  }
  .residency-pill {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 600;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--type-hike);
    color: var(--type-hike-text);
  }
  .meta-row {
    margin-top: auto;
    padding-top: 2px;
    column-gap: var(--space-3);
  }
  .meta-row > * + *::before {
    content: none;
  }
  .meta-row > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  /* The season is the long, free-text fact: it truncates with an ellipsis
     instead of being cut mid-glyph (block, so text-overflow applies). */
  .meta-row > span:last-child {
    display: block;
  }
  .meta-row > span:last-child :global(svg) {
    display: inline-block;
    vertical-align: -1px;
    margin-right: 5px;
  }
  .meta-row :global(svg) {
    flex: none;
    color: var(--text-muted);
  }
  /* Straight-line distance from the visitor, filled in once located. */
  .dist {
    color: var(--accent);
    font-weight: 600;
  }
  .dist::before {
    content: '';
    width: 8px;
    height: 8px;
    margin-right: 2px;
    border-radius: 50%;
    background: #0a84ff;
    box-shadow: 0 0 0 2px color-mix(in srgb, #0a84ff 25%, transparent);
  }
  .dist[hidden] {
    display: none !important;
  }
</style>
