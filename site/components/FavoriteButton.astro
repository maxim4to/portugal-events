---
// Private "favorite / shortlist" toggle backed by localStorage (see
// FavoriteController). Unlike VisitedButton it is always available — no config,
// no network — so it renders visible by default.
interface Props {
  placeId: string;
  variant?: 'card' | 'detail';
}
const { placeId, variant = 'detail' } = Astro.props;
---
<button
  type="button"
  class:list={['favorite-btn', `favorite-btn--${variant}`, { 'icon-tip': variant === 'card' }]}
  data-favorite-id={placeId}
  data-tip="В избранное"
  data-tip-on="В избранном"
  aria-pressed="false"
  aria-label="В избранное"
>
  <svg class="favorite-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-heart" /></svg>
  <span class="favorite-label">В избранное</span>
</button>

<style>
  .favorite-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 550;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .favorite-btn:hover {
    border-color: var(--text-secondary);
  }
  .favorite-btn:active {
    transform: scale(0.94);
  }
  .favorite-btn:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-bg);
  }
  .favorite-btn[aria-pressed='true'] {
    color: var(--danger);
    border-color: var(--danger);
  }
  .favorite-btn[aria-pressed='true'] .favorite-icon {
    fill: var(--danger);
  }
  .favorite-btn[aria-pressed='true'] .favorite-icon {
  }
  .favorite-icon {
    flex: none;
  }
  .favorite-icon {
    transition: fill 0.15s ease;
  }

  /* Detail page: equal-width secondary tiles (icon over a sentence-case
     label) that share one row in the aside, however many are visible. */
  .favorite-btn--detail {
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    min-height: 64px;
    padding: var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-primary);
    font-size: 12.5px;
    font-weight: 550;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .favorite-btn--detail[hidden] {
    display: none;
  }
  @media (hover: hover) {
    .favorite-btn--detail:hover {
      border-color: var(--text-primary);
    }
  }
  .favorite-btn--detail:active {
    transform: scale(0.97);
  }
  .favorite-btn--detail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: none;
  }
  .favorite-btn--detail[aria-pressed='true'] {
    color: var(--danger);
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, var(--surface-2));
  }
  .favorite-btn--detail .favorite-label {
    max-width: 100%;
  }

  /* Compact circular overlay for catalog cards. Shares an identical shell with
     VisitedButton's card variant — only the icon and pressed tint differ. */
  .favorite-btn--card {
    width: 32px;
    height: 32px;
    padding: 0;
    justify-content: center;
    border-radius: var(--radius-pill);
    min-height: 0;
    border: 0;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-2) 85%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-md);
  }
  .favorite-btn--card .favorite-label {
    display: none;
  }
  .favorite-btn--card .favorite-icon {
    width: 17px;
    height: 17px;
  }
  .favorite-btn--card[aria-pressed='true'] {
    color: var(--danger);
    border-color: var(--danger);
  }
  /* Bigger tap target on phones — 32px is fiddly under a finger. */
  @media (max-width: 760px) {
    .favorite-btn--card {
      width: 44px;
      height: 44px;
    }
    .favorite-btn--card .favorite-icon {
      width: 22px;
      height: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .favorite-btn {
      transition: none;
    }
    .favorite-btn:active {
      transform: none;
    }
    .favorite-btn[aria-pressed='true'] .favorite-icon {
      animation: none;
    }
  }
</style>
