---
interface Props {
  placeId: string;
  variant?: 'card' | 'detail';
}
const { placeId, variant = 'detail' } = Astro.props;
---
<button
  type="button"
  class:list={['visited-btn', `visited-btn--${variant}`, { 'icon-tip': variant === 'card' }]}
  data-visited-id={placeId}
  data-tip="Был здесь"
  data-tip-on="Отмечено"
  aria-pressed="false"
  aria-label="Был здесь"
  hidden
>
  {/* Not visited: an open eye. Visited: the same eye filled, with a check for
      its pupil — the "on" state is toggled purely by aria-pressed (see CSS). */}
  <svg class="visited-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-visited" /></svg>
  <svg class="visited-icon-on" width="18" height="18" fill="none" aria-hidden="true"><use href="#i-visited-on" /></svg>
  <span class="visited-label">Был здесь</span>
</button>

<style>
  .visited-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-secondary);
    font: inherit;
    font-size: 14px;
    font-weight: 550;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .visited-btn:hover {
    border-color: var(--border-strong);
  }
  .visited-btn:active {
    transform: scale(0.94);
  }
  /* Pressed = visited: the eye fills in a clear "seen" green — mirrors how the
     favorite heart fills, so it reads at a glance instead of a faint tint. */
  .visited-btn[aria-pressed='true'] {
    color: var(--visited);
    border-color: var(--visited);
  }
  .visited-btn[aria-pressed='true'] .visited-icon-on {
    animation: toggle-pop 180ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .visited-icon,
  .visited-icon-on {
    flex: none;
  }
  /* Swap the outline eye for the filled eye-with-check on the pressed state. */
  .visited-icon-on {
    display: none;
  }
  .visited-btn[aria-pressed='true'] .visited-icon {
    display: none;
  }
  .visited-btn[aria-pressed='true'] .visited-icon-on {
    display: block;
  }

  /* Detail page: equal-width secondary tiles (icon over a sentence-case
     label) that share one row in the aside, however many are visible. */
  .visited-btn--detail {
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    min-height: 64px;
    padding: var(--space-2) var(--space-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text-primary);
    font-size: 12.5px;
    font-weight: 550;
    line-height: 1.25;
    text-align: center;
    white-space: nowrap;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .visited-btn--detail[hidden] {
    display: none;
  }
  @media (hover: hover) {
    .visited-btn--detail:hover {
      border-color: var(--text-primary);
    }
  }
  .visited-btn--detail:active {
    transform: scale(0.97);
  }
  .visited-btn--detail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: none;
  }
  .visited-btn--detail[aria-pressed='true'] {
    color: var(--visited);
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, var(--surface-2));
  }
  .visited-btn--detail .visited-label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Compact circular overlay for catalog cards. Mirrors FavoriteButton's card
     variant exactly — same shell, only the icon and pressed tint differ. */
  .visited-btn--card {
    width: 32px;
    height: 32px;
    padding: 0;
    justify-content: center;
    border-radius: var(--radius-pill);
    min-height: 0;
    border: 0;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-2) 85%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-md);
  }
  .visited-btn--card .visited-icon,
  .visited-btn--card .visited-icon-on {
    width: 18px;
    height: 18px;
  }
  /* Icon-only on cards: the meaning is carried by the hover tip, not a label. */
  .visited-btn--card .visited-label {
    display: none;
  }
  .visited-btn--card[aria-pressed='true'] {
    color: var(--visited);
    border-color: var(--visited);
  }
  /* Bigger tap target on phones — 32px is fiddly under a finger. */
  @media (max-width: 760px) {
    .visited-btn--card {
      width: 44px;
      height: 44px;
    }
    .visited-btn--card .visited-icon,
    .visited-btn--card .visited-icon-on {
      width: 22px;
      height: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .visited-btn {
      transition: none;
    }
    .visited-btn:active {
      transform: none;
    }
    .visited-btn[aria-pressed='true'] .visited-icon-on {
      animation: none;
    }
  }
</style>
